apiVersion: v1
kind: ServiceAccount
metadata:
  name: watchdog-sa
  namespace: netflex-aiops
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: watchdog-role
rules:
- apiGroups: [""]
  resources: ["pods", "pods/log", "services", "configmaps"]
  verbs: ["get", "list", "watch"]
- apiGroups: ["networking.k8s.io"]
  resources: ["ingresses"]
  verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: watchdog-rolebinding
subjects:
- kind: ServiceAccount
  name: watchdog-sa
  namespace: netflex-aiops
roleRef:
  kind: ClusterRole
  name: watchdog-role
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: watchdog-script
  namespace: netflex-aiops
data:
  watchdog.py: |
    import os, sys, json, requests, urllib3
    from prometheus_client import start_http_server, Counter
    urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

    sys.stdout.reconfigure(line_buffering=True)
    print("🛡️ NetFlex Native JSON Ingress Telemetry Active on port 8000", flush=True)

    METRIC_HTTP_REQ = Counter('netflex_http_requests_total', 'HTTP Requests Ingested', ['method', 'status', 'path'])
    METRIC_EDGE_DROPS = Counter('netflex_edge_cli_drops_total', 'Hard Rule CLI Drops')

    start_http_server(8000)

    TOKEN_PATH = "/var/run/secrets/kubernetes.io/serviceaccount/token"
    with open(TOKEN_PATH, "r") as f:
        token = f.read().strip()

    headers = {"Authorization": f"Bearer {token}"}
    K8S_API = "https://kubernetes.default.svc"

    # Discover Ingress Pod
    r = requests.get(
        f"{K8S_API}/api/v1/namespaces/ingress-nginx/pods?labelSelector=app.kubernetes.io/name=ingress-nginx",
        headers=headers, verify=False, timeout=10
    )
    items = r.json().get("items", [])
    if not items:
        print("❌ Could not find Ingress Pod", flush=True)
        sys.exit(1)

    ingress_pod = items[0]["metadata"]["name"]
    print(f"📡 Streaming live JSON logs from pod: {ingress_pod}", flush=True)

    log_stream_url = f"{K8S_API}/api/v1/namespaces/ingress-nginx/pods/{ingress_pod}/log?follow=true&tailLines=0"
    with requests.get(log_stream_url, headers=headers, stream=True, verify=False) as stream_resp:
        for raw_line in stream_resp.iter_lines():
            if not raw_line:
                continue
            line = raw_line.decode('utf-8', errors='ignore').strip()
            
            # Native JSON Parsing
            try:
                data = json.loads(line)
                client_ip = data.get("remote_addr", "-")
                method = data.get("request_method", "-")
                path = data.get("request_uri", "-")
                status = str(data.get("status", "200"))
                ua = data.get("http_user_agent", "")

                if any(ign in path for ign in ["/metrics", "/healthz", "favicon.ico"]):
                    continue

                METRIC_HTTP_REQ.labels(method=method, status=status, path=path).inc()

                if status == "403":
                    METRIC_EDGE_DROPS.inc()
                    print(f"🛑 [HARD RULE BLOCKED] IP: {client_ip} | Path: {path} | Method: {method} | Status: 403 (CLI User-Agent: {ua})", flush=True)
                else:
                    print(f"✅ [ALLOWED USER] IP: {client_ip} | Path: {path} | Method: {method} | Status: {status}", flush=True)

            except json.JSONDecodeError:
                # Skips non-JSON system messages from nginx
                continue
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: netflex-aiops-watchdog
  namespace: netflex-aiops
spec:
  replicas: 1
  selector:
    matchLabels:
      app: netflex-watchdog
  template:
    metadata:
      labels:
        app: netflex-watchdog
    spec:
      serviceAccountName: watchdog-sa
      containers:
      - name: watchdog
        image: python:3.11-slim
        command:
        - /bin/sh
        - -c
        - |
          pip install -q --no-cache-dir requests prometheus_client urllib3
          python3 -u /app/watchdog.py
        volumeMounts:
        - name: script-vol
          mountPath: /app
        resources:
          limits:
            cpu: "300m"
            memory: "300Mi"
          requests:
            cpu: "50m"
            memory: "100Mi"
      volumes:
      - name: script-vol
        configMap:
          name: watchdog-script
